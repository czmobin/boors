# =========================================
# API KEY بورس ایران (BrsApi.ir)
# =========================================
# برای دریافت API Key رایگان به سایت زیر بروید:
# https://brsapi.ir/tsetmc-exchange-free-bourse-api-key-request/
BRSAPI_KEY=your_brsapi_key_here

# =========================================
# تنظیمات ربات تلگرام
# =========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID های کاربران مجاز (با کاما جدا شوند)
# برای پیدا کردن Chat ID خود، به @userinfobot پیام دهید
AUTHORIZED_USERS=123456789,987654321
